#!/usr/bin/env bash
# neowallpaperlive — command-line control for the NeoWallpaperLive GNOME extension.
# All state lives in GSettings; the extension reacts to changes immediately.
set -euo pipefail

UUID="neowallpaperlive@local"
SCHEMA="org.gnome.shell.extensions.neowallpaperlive"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
EXT_DIR="$DATA_HOME/gnome-shell/extensions/$UUID"
DESKTOP_FILE="$DATA_HOME/applications/neowallpaperlive-renderer.desktop"
BUS="org.neowallpaperlive.Control"
OBJ="/org/neowallpaperlive/Control"
SELF="$(realpath -- "${BASH_SOURCE[0]}")"

usage() {
    cat <<EOF
NeoWallpaperLive — live video wallpaper on every monitor

Usage: neowallpaperlive <command> [arguments]

Playback
  set FILE                play FILE on every monitor, and remember it
  exit | stop             stop playing; the static wallpaper comes back
  start | resume          play the remembered file again
  fill MODE               how the video is fitted to each monitor
                            MODE: cover (default) | contain | stretch

Power saving
  autopause               show the three rules and whether the video is
                          paused right now
  autopause RULE on|off   turn one rule on or off
                            covered     pause when every monitor is hidden
                                        behind windows            (default on)
                            fullscreen  pause while a fullscreen app is on
                                        top of any monitor        (default on)
                            battery     pause while running on battery
                                                                  (default off)
  awake on|off            keep the computer awake — no automatic suspend and
                          no screen blanking or locking — while the wallpaper
                          is playing                              (default off)

Diagnostics
  status                  settings plus live state: monitors, renderer pid,
                          decoder in use, playback position
  log                     follow the extension's log (Ctrl-C to stop)
  mpv-args [ARG...]       extra mpv flags for troubleshooting;
                          with no arguments, clears them

Other
  uninstall [-y]          remove the extension, the CLI and all settings
  help                    this text

Examples
  neowallpaperlive set ~/Videos/ocean.mp4
  neowallpaperlive autopause                   # see what is set right now
  neowallpaperlive autopause fullscreen off    # keep playing behind games
  neowallpaperlive autopause battery on        # save power on a laptop
  neowallpaperlive fill contain                # letterbox instead of cropping
  neowallpaperlive awake on
  neowallpaperlive exit

Every setting is remembered across logins. After installing or updating the
extension, log out and back in before the new code takes effect.
EOF
}

die() { echo "neowallpaperlive: $*" >&2; exit 1; }

gs() { gsettings --schemadir "$EXT_DIR/schemas" "$@"; }

# GVariant string literal: single quotes, escape backslash and quote.
gvariant_string() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\'/\\\'}
    printf "'%s'" "$s"
}

check_installed() {
    [[ -f "$EXT_DIR/schemas/gschemas.compiled" ]] ||
        die "extension not installed. Run install.sh from the repository first."
}

extension_state() {
    gnome-extensions info "$UUID" 2>/dev/null | awk -F': *' '/^ *State:/{print $2}' || true
}

hint_if_not_active() {
    local state
    state=$(extension_state)
    case "$state" in
        ACTIVE) ;;
        "") echo "note: GNOME Shell does not know the extension yet — log out and back in, then run this again." ;;
        *)  echo "note: extension state is '$state' (expected ACTIVE). Try: gnome-extensions enable $UUID, or log out and back in." ;;
    esac
}

dbus_status() {
    gdbus call --session --dest "$BUS" --object-path "$OBJ" --method "$BUS.Status" 2>/dev/null |
        python3 -c 'import ast,sys,json
raw=sys.stdin.read().strip()
if not raw: sys.exit(1)
print(json.dumps(json.loads(ast.literal_eval(raw)[0]), indent=2))' 2>/dev/null
}

# One field of the runtime status, or empty if the extension is not reachable.
runtime_field() {
    gdbus call --session --dest "$BUS" --object-path "$OBJ" --method "$BUS.Status" 2>/dev/null |
        python3 -c 'import ast,sys,json
raw=sys.stdin.read().strip()
if not raw: sys.exit(1)
v=json.loads(ast.literal_eval(raw)[0])
for k in sys.argv[1].split("."): v=v.get(k) if isinstance(v,dict) else None
print("" if v is None else str(v).lower() if isinstance(v,bool) else v)' "$1" 2>/dev/null
}

# Number of keep-awake inhibitors registered at gnome-session in our name.
awake_inhibitors() {
    local n=0 o
    for o in $(gdbus call --session --dest org.gnome.SessionManager --object-path /org/gnome/SessionManager \
                --method org.gnome.SessionManager.GetInhibitors 2>/dev/null | grep -o "/org/gnome/SessionManager/Inhibitor[0-9]*"); do
        gdbus call --session --dest org.gnome.SessionManager --object-path "$o" \
            --method org.gnome.SessionManager.Inhibitor.GetAppId 2>/dev/null | grep -q "'neowallpaperlive'" && n=$((n+1))
    done
    echo "$n"
}

cmd_awake() {
    [[ $# -eq 1 ]] || die "usage: neowallpaperlive awake on|off"
    check_installed
    case "$1" in
        on)
            gs set "$SCHEMA" keep-awake true
            local playing
            playing=$(runtime_field playing)
            if [[ "$playing" == "true" ]]; then
                sleep 0.5
                if [[ "$(runtime_field keepAwake.active)" == "true" ]]; then
                    echo "keep-awake: on (active — no suspend, no screen blanking while the wallpaper plays)"
                else
                    echo "keep-awake: on, but not active: $(runtime_field keepAwake.error)"
                fi
            elif [[ -z "$playing" ]]; then
                echo "keep-awake: on (remembered)"
                echo "note: extension not reachable in this session; it takes effect once the wallpaper plays."
                hint_if_not_active
            else
                echo "keep-awake: on (remembered)"
                echo "note: the wallpaper is not playing, so nothing is inhibited yet. It takes effect after: neowallpaperlive start"
            fi
            ;;
        off)
            gs set "$SCHEMA" keep-awake false
            echo "keep-awake: off"
            ;;
        *) die "usage: neowallpaperlive awake on|off" ;;
    esac
}

cmd_autopause() {
    check_installed
    if [[ $# -eq 0 ]]; then
        echo "covered:    $(gs get "$SCHEMA" pause-when-covered)   (pause when every monitor is hidden behind windows)"
        echo "fullscreen: $(gs get "$SCHEMA" pause-on-fullscreen)   (pause while a fullscreen app is on top of any monitor)"
        echo "battery:    $(gs get "$SCHEMA" pause-on-battery)   (pause while on battery)"
        local paused
        paused=$(runtime_field autoPause.paused)
        if [[ "$paused" == "true" ]]; then
            echo "now:        paused ($(runtime_field autoPause.reasons))"
        elif [[ "$paused" == "false" ]]; then
            echo "now:        playing"
        fi
        return
    fi
    [[ $# -eq 2 ]] || die "usage: neowallpaperlive autopause [covered|fullscreen|battery on|off]"
    local key
    case "$1" in
        covered)    key=pause-when-covered ;;
        fullscreen) key=pause-on-fullscreen ;;
        battery)    key=pause-on-battery ;;
        *) die "unknown rule: $1 (covered | fullscreen | battery)" ;;
    esac
    case "$2" in
        on)  gs set "$SCHEMA" "$key" true ;;
        off) gs set "$SCHEMA" "$key" false ;;
        *) die "expected on|off, got: $2" ;;
    esac
    echo "auto-pause $1: $2"
}

cmd_set() {
    [[ $# -eq 1 ]] || die "usage: neowallpaperlive set FILE"
    local file=$1 path
    [[ -f "$file" ]] || die "no such file: $file"
    path=$(realpath -- "$file")
    check_installed
    gs set "$SCHEMA" video-path "$(gvariant_string "$path")"
    gs set "$SCHEMA" enabled true
    echo "wallpaper: $path"
    hint_if_not_active
}

cmd_exit() {
    check_installed
    gs set "$SCHEMA" enabled false
    echo "stopped (video path kept; 'neowallpaperlive start' resumes)"
}

cmd_start() {
    check_installed
    local path
    path=$(gs get "$SCHEMA" video-path | sed "s/^'//; s/'\$//")
    [[ -n "$path" ]] || die "no video set yet. Use: neowallpaperlive set FILE"
    gs set "$SCHEMA" enabled true
    echo "wallpaper: $path"
    hint_if_not_active
}

cmd_fill() {
    [[ $# -eq 1 ]] || die "usage: neowallpaperlive fill cover|contain|stretch"
    case "$1" in cover|contain|stretch) ;; *) die "unknown fill mode: $1" ;; esac
    check_installed
    gs set "$SCHEMA" fill-mode "'$1'"
    echo "fill mode: $1"
}

cmd_mpv_args() {
    check_installed
    if [[ $# -eq 0 ]]; then
        gs set "$SCHEMA" mpv-extra-args "[]"
        echo "mpv extra args cleared"
        return
    fi
    local list="" a
    for a in "$@"; do
        list+="${list:+, }$(gvariant_string "$a")"
    done
    gs set "$SCHEMA" mpv-extra-args "[$list]"
    echo "mpv extra args: $*"
}

cmd_status() {
    check_installed
    echo "extension:  $UUID  state=$(extension_state)"
    echo "session:    ${XDG_SESSION_TYPE:-unknown}  gnome-shell $(gnome-shell --version 2>/dev/null | awk '{print $3}')"
    echo "video-path: $(gs get "$SCHEMA" video-path)"
    echo "enabled:    $(gs get "$SCHEMA" enabled)"
    echo "fill-mode:  $(gs get "$SCHEMA" fill-mode)"
    echo "keep-awake: $(gs get "$SCHEMA" keep-awake)"
    echo "autopause:  covered=$(gs get "$SCHEMA" pause-when-covered) fullscreen=$(gs get "$SCHEMA" pause-on-fullscreen) battery=$(gs get "$SCHEMA" pause-on-battery)"
    echo "mpv-args:   $(gs get "$SCHEMA" mpv-extra-args)"
    echo "runtime:"
    if ! dbus_status | sed 's/^/  /'; then
        echo "  (extension not reachable on D-Bus — not loaded in this session)"
        hint_if_not_active
    fi
}

cmd_log() {
    exec journalctl --user -f -o cat _COMM=gnome-shell | grep --line-buffered -i 'neowallpaperlive'
}

cmd_uninstall() {
    local yes=0
    [[ "${1:-}" == "-y" ]] && yes=1
    if [[ $yes -eq 0 ]]; then
        read -r -p "Remove NeoWallpaperLive (extension, CLI, settings)? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted"; exit 0; }
    fi
    if [[ -f "$EXT_DIR/schemas/gschemas.compiled" ]]; then
        # Release the keep-awake inhibitor first, then stop playback; the
        # running extension reacts to both before it is disabled below.
        gs set "$SCHEMA" keep-awake false 2>/dev/null || true
        gs set "$SCHEMA" enabled false 2>/dev/null || true
        sleep 0.5
    fi
    gnome-extensions disable "$UUID" 2>/dev/null || true
    sleep 0.5
    if [[ "$(awake_inhibitors)" != "0" ]]; then
        echo "warning: a keep-awake inhibitor is still registered with gnome-session;" >&2
        echo "         it is released when you log out. (gnome-session-inhibit --list shows it)" >&2
    else
        echo "keep-awake: no inhibitor left behind"
    fi
    rm -rf -- "$EXT_DIR"
    rm -f -- "$DESKTOP_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database "$DATA_HOME/applications" 2>/dev/null || true
    command -v dconf >/dev/null && dconf reset -f /org/gnome/shell/extensions/neowallpaperlive/ 2>/dev/null || true
    echo "removed extension, desktop entry and settings"
    echo "removing CLI: $SELF"
    # Delete ourselves after this process exits so bash never reads a deleted script.
    nohup bash -c 'sleep 0.5; rm -f -- "$1"' _ "$SELF" >/dev/null 2>&1 &
    echo "done. Log out and back in to fully unload the extension from GNOME Shell."
}

main() {
    local cmd=${1:-help}
    shift || true
    case "$cmd" in
        set)            cmd_set "$@" ;;
        exit|stop)      cmd_exit ;;
        start|resume)   cmd_start ;;
        status)         cmd_status ;;
        fill)           cmd_fill "$@" ;;
        awake)          cmd_awake "$@" ;;
        autopause)      cmd_autopause "$@" ;;
        mpv-args)       cmd_mpv_args "$@" ;;
        log)            cmd_log ;;
        uninstall)      cmd_uninstall "$@" ;;
        help|-h|--help) usage ;;
        *)              usage >&2; exit 2 ;;
    esac
}

main "$@"
